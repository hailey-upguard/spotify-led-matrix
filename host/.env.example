# Copy to .env for local runs:  env $(grep -v '^#' .env | xargs) python -m spotify_matrix.main
# In k8s these come from the Secret + Deployment env (see k8s/).

# From your Spotify developer dashboard app:
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# From running auth_bootstrap.py once:
SPOTIFY_REFRESH_TOKEN=

# The panel's address (no scheme). Use its static IP from a k8s pod, since mDNS
# (ledmatrix.local) usually won't resolve across the cluster.
PANEL_HOST=192.168.1.42

# Optional tuning:
POLL_INTERVAL=4          # seconds between Spotify polls
ART_BRIGHTNESS=1.0       # 0..1 flat pre-scale on the art
RESAMPLE=BICUBIC         # downscale filter: LANCZOS / BICUBIC / BILINEAR /
                         #   HAMMING / BOX. LANCZOS rings on high-contrast edges
                         #   and lights up pixels the source has as pure black;
                         #   BOX is a plain area average, cleanest blacks but
                         #   slightly softer strokes.
POWER_LIMIT=0.5          # 0..1 max avg panel current; dims bright frames so a
                         #   USB-C port (esp. non-PD) can't brown out. Raise
                         #   toward 1.0 if you have a strong 5V/3A+ supply.
IDLE_TIMEOUT=1800        # seconds to keep the last cover after music stops
                         #   before blanking the panel (1800 = 30 min)
LOG_LEVEL=INFO
