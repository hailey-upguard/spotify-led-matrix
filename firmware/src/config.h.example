// Copy this file to config.h and fill in your values.  config.h is gitignored.
#pragma once

// ---- WiFi -------------------------------------------------------------------
#define WIFI_SSID     "your-wifi-ssid"
#define WIFI_PASSWORD "your-wifi-password"

// mDNS will not resolve from inside a k8s pod; give the panel a static DHCP lease
// and point the host at its IP.
#define LEDMATRIX_HOSTNAME "ledmatrix"

// ---- Panel geometry ---------------------------------------------------------
#define PANEL_WIDTH  64
#define PANEL_HEIGHT 64
#define PANEL_CHAIN  1

// ---- HUB75 pinout -----------------------------------------------------------
// Hard-wired on the MatrixPortal ESP32-S3; these are Adafruit's own MTX_* values,
// not a guess. If colours come out permuted that is the panel's channel order, so
// swap G/B here (e.g. G1<->B1 and G2<->B2 for an RBG panel).
#define R1_PIN 42
#define G1_PIN 41
#define B1_PIN 40
#define R2_PIN 38
#define G2_PIN 39
#define B2_PIN 37
#define A_PIN  45
#define B_PIN  36
#define C_PIN  48
#define D_PIN  35
#define E_PIN  21
#define LAT_PIN 47
#define OE_PIN  14
#define CLK_PIN 2

// ---- HUB75 timing -----------------------------------------------------------
// Panel properties, not board properties: they do not survive a panel swap. All
// tunable at runtime via POST /panel, which persists to NVS and overrides these.
// See firmware/README.md for what each one does and how these were arrived at.
//
// driver 0 = plain shift register. latch_blanking 2 is what stopped this panel
// ghosting. clkphase false despite the library defaulting to true, otherwise the
// image shifts a pixel right and column 0 wraps to the far edge.
#define PANEL_DRIVER         0
#define PANEL_CLKPHASE       false
#define PANEL_LATCH_BLANKING 2

// Bits per channel in the panel's BCM planes, 2-12. Higher resolves more of the
// 256 input levels (8/10/12 give 174/236/256) but is visibly dimmer on this panel,
// and the brightness matters more here than the extra levels.
#define PANEL_COLOR_DEPTH    8

// Pixel clock, 8/16/20 MHz. Buys refresh headroom, not brightness.
#define PANEL_I2S_MHZ        8

// ---- Brightness -------------------------------------------------------------
// Capped at ~63% of full range: the supply browns out above this on bright
// frames, so the ceiling backs up PANEL_POWER_LIMIT rather than relying on it
// alone.
#define MAX_BRIGHTNESS     160
#define DEFAULT_BRIGHTNESS MAX_BRIGHTNESS

// Ceiling on average output duty, 0-255 (0 disables). Enforced by the panel from
// the frame it was handed, which bounds mean-pixel-value x brightness -- the thing
// current actually follows. The host cannot do that, having only seen the pixels.
#define PANEL_POWER_LIMIT  102

// Brightness changes ramp instead of snapping: each tick closes 1/RAMP_DIV of the
// remaining gap, so scheduled dims fade rather than step.
#define BRIGHTNESS_STEP_INTERVAL 25
#define BRIGHTNESS_RAMP_DIV      12

// ---- Album art transitions --------------------------------------------------
// FADE_MS is per direction, so a cover swap takes roughly twice this.
#define FADE_MS            220
#define FADE_STEP_INTERVAL 12
