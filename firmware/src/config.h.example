// Copy this file to config.h and fill in your values.  config.h is gitignored.
#pragma once

// ---- WiFi -------------------------------------------------------------------
#define WIFI_SSID     "your-wifi-ssid"
#define WIFI_PASSWORD "your-wifi-password"

// mDNS hostname. The panel will be reachable at http://LEDMATRIX_HOSTNAME.local
// on networks where mDNS works. From a k8s pod, mDNS usually will NOT resolve,
// so give the ESP32 a static DHCP lease and point the host at its IP instead.
#define LEDMATRIX_HOSTNAME "ledmatrix"

// Optional: protect OTA updates with a password. Uncomment to enable, and pass
// the same value via upload_flags in the OTA env (see platformio.ini).
// #define OTA_PASSWORD "change-me"

// ---- Panel geometry ---------------------------------------------------------
#define PANEL_WIDTH  64
#define PANEL_HEIGHT 64
#define PANEL_CHAIN  1   // number of panels daisy-chained (1 for a single 64x64)

// ---- HUB75 pinout -----------------------------------------------------------
// These values are taken from the ORIGINAL ClockWise Plus firmware that shipped
// on this exact board (yuan910715/clockwise), so they are correct for it: all
// library defaults except E = GPIO 18.
//
// This board is RBG (confirmed), so the G and B pins are swapped vs the library
// default: B1=26/G1=27 and B2=12/G2=13. (The OEM firmware does the same via its
// swapBlueGreen toggle.) If colors ever look off, the default RGB ordering is
// B1=27/G1=26 and B2=13/G2=12.
#define R1_PIN 25
#define G1_PIN 27
#define B1_PIN 26
#define R2_PIN 14
#define G2_PIN 13
#define B2_PIN 12
#define A_PIN  23
#define B_PIN  19
#define C_PIN  5
#define D_PIN  17
#define E_PIN  18   // GPIO 18 on this board (confirmed from the OEM firmware).
#define LAT_PIN 4
#define OE_PIN  15
#define CLK_PIN 16

// ---- Display ----------------------------------------------------------------
// MAX_BRIGHTNESS is a hard ceiling the panel will never exceed (the /brightness
// endpoint is clamped to it too). Set to 60% for a living-room-friendly glow.
// This also helps the USB-C power budget, since brightness scales current
// linearly; the host additionally caps per-frame current via POWER_LIMIT.
#define MAX_BRIGHTNESS     153  // 0.60 * 255
#define DEFAULT_BRIGHTNESS MAX_BRIGHTNESS
